{
  // Telemetry settings
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  // UI settings
  "workbench.activityBar.autoHide": true,
  "workbench.activityBar.compact": true,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "One Dark Pro Flat",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tips.enabled": false,
  "window.density.editorTabHeight": "compact",
  "extensions.ignoreRecommendations": true,
  "vscode-kubernetes.helm-path-linux": "${userHome}/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/helm",
  "vscode-kubernetes.kubectl-path-linux": "${userHome}/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/kubectl",
  // Editor settings
  "editor.formatOnSave": true,
  "editor.minimap.enabled": true,
  "editor.fontSize": 14,
  "editor.fontFamily": "MesloLGS NF, Consolas, 'Courier New', monospace",
  "editor.rulers": [
    80,
    120
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.venv": true,
    "**/.devbox": true,
    "**/.ipynb_checkpoints": true
  },
  "python.defaultInterpreterPath": "/home/linuxbrew/.linuxbrew/bin/python3.11",
  "python-envs.alwaysUseUv": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/.devbox": true,
    "**/.ipynb_checkpoints": true
  },
  // Dictionary
  "cSpell.language": "en,pt",
  "cSpell.userWords": [
    "akuity",
    "alertmanager",
    "applicationset",
    "atuin",
    "awscli",
    "azureblob",
    "bigpanda",
    "bitnami",
    "blackbox",
    "cadvisor",
    "certifi",
    "clickhouse",
    "cloudhealth",
    "codespell",
    "commitizen",
    "cooldown",
    "crossplane",
    "crowdstrike",
    "dapr",
    "direnv",
    "docstrings",
    "dozzle",
    "externalsecret",
    "externalsecrets",
    "fastapi",
    "fastfetch",
    "fluentbit",
    "gitea",
    "gitops",
    "gitversion",
    "hami",
    "healthcheck",
    "helmreleases",
    "intermedia",
    "ipynb",
    "kafbat",
    "kargo",
    "karpenter",
    "keras",
    "keyspace",
    "kiali",
    "kubeconfig",
    "kubelet",
    "kyverno",
    "langfuse",
    "linuxbrew",
    "litellm",
    "livekit",
    "lualatex",
    "matplotlib",
    "mkdocs",
    "mlflow",
    "mlops",
    "nextauth",
    "numpy",
    "onnx",
    "oomkill",
    "openbao",
    "opensips",
    "pprint",
    "prek",
    "psql",
    "psycopg",
    "pydantic",
    "pyproject",
    "pytest",
    "pyyaml",
    "qualys",
    "rollouts",
    "runbook",
    "scikit",
    "scim",
    "slurm",
    "streamlit",
    "synthflow",
    "tamasfe",
    "tika",
    "tolerations",
    "torchvision",
    "trixie",
    "uvicorn",
    "valkey",
    "vcluster",
    "velero",
    "venv",
    "vertexai",
    "virtualenv",
    "vmagent",
    "vmsingle",
    "yazi"
  ],
  "git.addAICoAuthor": "off",
  // GitHub Copilot settings
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "env": false,
    "dotenv": false,
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.rulers": [
      80,
      120
    ],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": false
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  // make sure the go language server is enabled
  "go.useLanguageServer": true,
  "go.formatTool": "goimports",
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--fast"
  ],
  "[dockerfile]": {
    "editor.quickSuggestions": {
      "strings": true
    },
  },
  // hadolint settings - dockerfile linter
  "hadolint.outputLevel": "warning",
  "hadolint.cliOptions": [
    "--no-color"
  ],
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "checkWith": "clippy",
    "checkOnSave": true
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "workbench.browser.enableChatTools": true
}