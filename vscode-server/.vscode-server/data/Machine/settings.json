{
  // Telemetry settings
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  // UI settings
  "workbench.activityBar.autoHide": true,
  "workbench.activityBar.compact": true,
  "workbench.activityBar.location": "top",
  "workbench.browser.enableChatTools": true,
  "workbench.colorTheme": "One Dark Pro Flat",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tips.enabled": false,
  "window.density.editorTabHeight": "compact",
  "extensions.ignoreRecommendations": true,
  "vscode-kubernetes.helm-path-linux": "${userHome}/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/helm",
  "vscode-kubernetes.kubectl-path-linux": "${userHome}/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/kubectl",
  // Editor settings
  "editor.formatOnSave": true,
  "editor.minimap.enabled": true,
  "editor.fontSize": 14,
  "editor.fontFamily": "MesloLGS NF, Consolas, 'Courier New', monospace",
  "editor.rulers": [
    80,
    120
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.venv": true,
    "**/.devbox": true,
    "**/.ipynb_checkpoints": true
  },
  // Python settings
  "python.defaultInterpreterPath": "/usr/bin/python",
  "python.analysis.typeCheckingMode": "standard",
  "python-envs.alwaysUseUv": true,
  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/.devbox": true,
    "**/.ipynb_checkpoints": true
  },
  // Dictionary
  "cSpell.language": "en,pt",
